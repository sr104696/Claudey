# Git bundles
*.bundle

# agent worktrees
.claude/worktrees/
# secrets
.env

# HTTP response cache and rate-limit state (regenerated each run)
cache/

# per-run scratch (request logs, judgment batches); summaries land in out/
data/runs/
# judgment batches are committed so a Claude session without network access can judge them (results are applied
# at the start of the next run); applied result files are not
data/judgments/*
!data/judgments/pending/
!data/judgments/results/
data/judgments/results/*.applied
data/.leads.lock
# saved alert emails are private
data/inbox/

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# SQLite is a local working store; the committed history lives in out/ and data/*.jsonl|csv
data/jobs.sqlite
data/jobs.sqlite-*
data/jobs.sqlite*.corrupt-*
